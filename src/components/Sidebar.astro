---
import { identity, sections } from '../data/profile';

// Avatar renders automatically once src/images/headshot.{jpg,png,webp} exists.
const headshots = import.meta.glob('../images/headshot.{jpg,png,webp}', {
  eager: true,
  query: '?url',
  import: 'default'
});
const headshot = Object.values(headshots)[0] as string | undefined;
---

<header class="left">
  <div>
    {headshot && <img class="avatar" src={headshot} alt={`${identity.fullName} — headshot`} width="96" height="96" />}
    <h1>{identity.name}</h1>
    <p class="role" aria-label={identity.roles.join(', ')}>
      <span id="typed" data-roles={JSON.stringify(identity.roles)}>{identity.roles[0]}</span><span class="cursor" aria-hidden="true">|</span>
    </p>
    <p class="tagline" set:html={identity.taglineHtml} />
    <p class="locale">{identity.location} · UTC+5</p>
    <nav class="site" aria-label="Section navigation">
      {sections.map((s, i) => (
        <a href={`#${s.id}`} class={i === 0 ? 'active' : ''}><span class="ln"></span>{s.label}</a>
      ))}
    </nav>
  </div>

  <div style="display:flex;flex-direction:column;gap:24px">
    <div class="actions">
      <a class="btn primary" href={`mailto:${identity.email}`}>Let's talk →</a>
      <a class="btn" href={identity.resumePdf} target="_blank" rel="noopener">View Résumé ↗</a>
    </div>
    <div class="social">
      <a href={identity.github} target="_blank" rel="noopener" aria-label="GitHub profile">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0C17 4.7 18 5 18 5c.6 1.6.2 2.8.1 3.1.7.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
      </a>
      <a href={identity.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn profile">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 20.4h-3.6v-5.6c0-1.3 0-3-1.9-3-1.9 0-2.1 1.4-2.1 2.9v5.7H9.2V9h3.4v1.6h.1c.5-.9 1.7-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.4H3.5V9h3.6v11.4zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg>
      </a>
      <a href={`mailto:${identity.email}`} aria-label="Email Uzair">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4.2-8 5-8-5V6l8 5 8-5v2.2z"/></svg>
      </a>
    </div>
  </div>
</header>
