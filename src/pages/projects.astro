---
import Layout from '../layouts/Layout.astro';
import { archiveProjects, projects, identity } from '../data/profile';
---

<Layout
  title="Project Archive — Uzair Ashraf | Full-Stack & AI Engineer"
  description="Complete archive of projects by Hafiz Uzair Ashraf — fintech, payments, healthcare, ERP and SaaS platforms built across 9+ years."
>
  <div class="wrap archive-wrap">
    <main class="archive" id="main">
      <a class="back" href="/">← {identity.name}</a>
      <h1>Project Archive</h1>
      <p class="intro">
        Everything I've shipped across 9+ years — fintech and payments first,
        plus healthcare, ERP and SaaS. The four featured projects are on the
        <a href="/#projects" class="inline-link">home page</a>.
      </p>

      <h2 class="sec-h"><span class="num">A.</span> Featured</h2>
      <div class="rows" role="list">
        {projects.map((p) => (
          <div class="row" role="listitem">
            <span class="year badge-cell">Featured</span>
            <div>
              {p.url
                ? <a class="pname" href={p.url} target="_blank" rel="noopener">{p.name} <span aria-hidden="true">↗</span></a>
                : <span class="pname">{p.name}</span>}
              <p class="pdesc" set:html={p.descriptionHtml} />
              <ul class="chips">{p.tech.map((t) => <li class="chip">{t}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>

      <h2 class="sec-h" style="margin-top:64px"><span class="num">B.</span> Archive</h2>
      <div class="rows" role="list">
        {archiveProjects.map((p) => (
          <div class="row" role="listitem">
            <span class="year">{p.year}</span>
            <div>
              {p.url
                ? <a class="pname" href={p.url} target="_blank" rel="noopener">{p.name} <span aria-hidden="true">↗</span></a>
                : <span class="pname">{p.name}</span>}
              <p class="pdesc">{p.description}</p>
              <ul class="chips">{p.tech.map((t) => <li class="chip">{t}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>

      <footer style="margin-top:64px">
        © {new Date().getFullYear()} {identity.fullName} — Senior Full-Stack Software Engineer. All rights reserved.
      </footer>
    </main>
  </div>
</Layout>

<style>
  .archive-wrap { display: block; max-width: 900px; }
  .archive { padding: 72px 0 24px; }
  .back {
    font-family: var(--mono); font-size: 13px; color: var(--accent);
    display: inline-block; margin-bottom: 24px;
  }
  h1 { margin-bottom: 12px; }
  .intro { color: var(--dim); max-width: 560px; margin-bottom: 48px; }
  .inline-link { color: var(--accent); }
  .rows { display: flex; flex-direction: column; gap: 8px; }
  .row {
    display: grid; grid-template-columns: 90px 1fr; gap: 20px;
    padding: 18px 20px; border-radius: 12px; border: 1px solid transparent; transition: 0.25s;
  }
  .row:hover { background: var(--card); border-color: var(--border); }
  .year { font-family: var(--mono); font-size: 12.5px; color: var(--dim); padding-top: 3px; }
  .badge-cell { color: var(--accent); }
  .pname { color: var(--heading); font-weight: 600; }
  a.pname:hover { color: var(--accent); }
  .pdesc { color: var(--dim); font-size: 14.5px; margin-top: 6px; }
  @media (max-width: 900px) {
    .row { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
